# Copy to .env and load it before serving. The app reads the process environment and does
# NOT open this file itself:
#
#     set -a; . ./.env; set +a
#     direnv exec . llmimage serve
#     # systemd: EnvironmentFile=/etc/llmimage/env
#
# Every variable is optional; the default is shown in the comment.
# `llmimage info` prints what a configuration actually resolves to.

# Bind address and port. 0.0.0.0 makes the studio reachable from other devices.
LLMIMAGE_HOST=127.0.0.1
LLMIMAGE_PORT=8765

# Default upstream OpenAI-compatible image API root ("/v1" is appended if missing).
# With this set, a browser needs only the key — never an address.
LLMIMAGE_BASE_URL=http://127.0.0.1:8080/v1

# Bearer token used when the browser does not supply X-Api-Key.
LLMIMAGE_API_KEY=

# Comma-separated hostname globs the proxy may contact. Set this whenever the bind address
# is not loopback: the browser chooses the upstream, so an unbounded proxy is an open relay
# for anything this machine can reach.
# LLMIMAGE_ALLOWED_HOSTS=127.0.0.1,localhost,api.openai.com

# Seconds an upstream image request may run. Local diffusion on CPU-offloaded weights is
# measured in minutes, so this is deliberately generous.
# LLMIMAGE_REQUEST_TIMEOUT=1800

# Request body cap in bytes (default 256 MiB, sized for many reference images).
# LLMIMAGE_MAX_BODY_BYTES=268435456

# Connection profile store. Defaults to ./data/settings.json in a source checkout and
# $XDG_DATA_HOME/llmimage/settings.json when installed from a package.
# LLMIMAGE_DATA_DIR=
# LLMIMAGE_CONFIG_FILE=

# Where the built SPA lives (the packaged copy by default). Missing = API-only mode.
# LLMIMAGE_WEB_DIST=
