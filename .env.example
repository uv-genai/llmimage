# Copy to .env or export before `uv run llmimage serve`.
# Upstream OpenAI-compatible image API root ("/v1" is appended if missing).
LLMIMAGE_BASE_URL=http://127.0.0.1:8080/v1
# Bearer token sent when the browser does not supply one.
LLMIMAGE_API_KEY=
# Optional: comma-separated hostname globs the proxy may contact.
# LLMIMAGE_ALLOWED_HOSTS=127.0.0.1,api.openai.com
# LLMIMAGE_HOST=127.0.0.1
# LLMIMAGE_PORT=8765
# LLMIMAGE_REQUEST_TIMEOUT=1800
